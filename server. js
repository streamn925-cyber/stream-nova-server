require('dotenv').config();
const express = require('express');
const axios = require('axios');
const cors = require('cors');

const app = express();
app.use(cors());
app.use(express.json());

const TMDB_API = process.env.TMDB_API_KEY || '04c35731a5ee918f014970082a0088b1';

// Root Route
app.get('/', (req, res) => {
    res.json({ status: "online", message: "StreamNova Minimal Server is running!" });
});

// Health Check
app.get('/api/v1/health', (req, res) => {
    res.json({ success: true, status: 'online' });
});

// Simple TMDB Test Route
app.get('/api/v1/discover', async (req, res) => {
    try {
        const response = await axios.get(`https://api.themoviedb.org/3/trending/movie/day?api_key=${TMDB_API}`);
        res.json({ success: true, results: response.data.results });
    } catch (error) {
        console.error(error.message);
        res.status(500).json({ success: false, error: "TMDB API failed" });
    }
});

// Simple Player Source (VidLink)
app.get('/api/v1/player/:id/sources', async (req, res) => {
    const { id } = req.params;
    try {
        const vidLinkRes = await axios.get(`https://vidlink.pro/api/b/movie/${id}`);
        if (vidLinkRes.data && vidLinkRes.data.stream && vidLinkRes.data.stream.playlist) {
            return res.json({ 
                success: true, 
                sources: [{ provider: 'VidLink', url: vidLinkRes.data.stream.playlist, type: 'hls' }] 
            });
        }
        res.status(404).json({ success: false, error: "No source found" });
    } catch (error) {
        res.status(500).json({ success: false, error: "Extraction failed" });
    }
});

// Start Server - Explicitly binding to 0.0.0.0 to prevent Render network issues
const PORT = process.env.PORT || 3000;
app.listen(PORT, '0.0.0.0', () => {
    console.log(`🚀 MINIMAL SERVER running on port ${PORT}`);
});
